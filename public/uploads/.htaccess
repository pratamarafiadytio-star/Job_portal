# ==============================================================
# Prevent Script Execution in Uploads Directory
# ==============================================================
Options -ExecCGI -Indexes
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|pl|py|cgi|asp|aspx|sh|bash|exe|html|htm|js|svg)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
